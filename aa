import pygame
import random
import math
import sys

# Initialize constants
WIDTH, HEIGHT = 800, 600
BLACK = (0, 0, 0)
FPS = 60

class Particle:
    def __init__(self, x, y, color):
        angle = random.uniform(0, 2 * math.pi)
        speed = random.uniform(2, 6)
        self.vx = math.cos(angle) * speed
        self.vy = math.sin(angle) * speed
        self.x = x
        self.y = y
        self.gravity = 0.05
        self.alpha = 255
        self.color = color

    def update(self):
        self.x += self.vx
        self.y += self.vy
        self.vy += self.gravity
        self.alpha -= 2
        return self.alpha > 0

    def draw(self, surface):
        if self.alpha > 0:
            color = (*self.color, max(0, min(255, int(self.alpha))))
            pygame.draw.circle(surface, color, (int(self.x), int(self.y)), 2)

class Firework:
    def __init__(self):
        self.x = random.randint(100, WIDTH-100)
        self.y = HEIGHT
        self.target_y = random.randint(100, HEIGHT//2)
        self.color = [random.randint(128, 255) for _ in range(3)]
        self.rocket_vy = random.uniform(-7, -10)
        self.exploded = False
        self.particles = []
        self.rocket_alpha = 255

    def update(self):
        if not self.exploded:
            self.y += self.rocket_vy
            self.rocket_vy += 0.05
            self.rocket_alpha -= 3
            if self.y <= self.target_y or self.rocket_vy > 0:
                self.explode()
        else:
            self.particles = [p for p in self.particles if p.update()]

    def explode(self):
        self.exploded = True
        for _ in range(60):
            self.particles.append(Particle(self.x, self.y, self.color))

    def draw(self, surface):
        if not self.exploded:
            color = (*self.color, max(0, min(255, int(self.rocket_alpha))))
            pygame.draw.circle(surface, color, (int(self.x), int(self.y)), 4)
        for p in self.particles:
            p.draw(surface)

def main():
    pygame.init()
    screen = pygame.display.set_mode((WIDTH, HEIGHT))
    pygame.display.set_caption("Fireworks!")
    clock = pygame.time.Clock()
    fireworks = [Firework() for _ in range(3)]
    running = True

    while running:
        clock.tick(FPS)
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                running = False

        if random.random() < 0.03:
            fireworks.append(Firework())

        screen.fill(BLACK)
        for fw in fireworks[:]:
            fw.update()
            fw.draw(screen)
            if fw.exploded and not fw.particles:
                fireworks.remove(fw)

        pygame.display.flip()

    pygame.quit()
    sys.exit()

if __name__ == "__main__":
    main()
